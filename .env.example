# Environment variables for hybrid-engine-dns
# Copy this file to .env and fill in your actual values

# ACME Configuration for Let's Encrypt SSL certificates
ACME_EMAIL=your-email@example.com
ACME_DNS_PROVIDER=cloudflare

# DNS Provider API credentials (example for Cloudflare)
# Uncomment and configure for your DNS provider
# CF_DNS_API_TOKEN=your_cloudflare_api_token
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Pi-hole Web UI Password (optional, generates random if not set)
# PIHOLE_WEBPASSWORD=your_secure_password